      "x_signature": "ae417d4c76e2eac03c69224601e28c9c360a95cc0bc36cb36a0aaf5842c46ee4",
      "canonical": "{\"email\":\"ada@acme.com\",\"event\":\"user_store.verify_password\",\"jti\":\"00000000-0000-4000-8000-000000000001\",\"password\":\"correct horse battery staple\",\"tenant\":\"acme\",\"timestamp\":\"2026-11-17T06:00:00.250Z\"}",
      "expected_payload": {
        "event": "user_store.verify_password",
        "tenant": "acme",
        "email": "ada@acme.com",
        "password": "correct horse battery staple",
        "timestamp": "2026-11-17T06:00:00.250Z",
        "jti": "00000000-0000-4000-8000-000000000001",
        "signature": "ae417d4c76e2eac03c69224601e28c9c360a95cc0bc36cb36a0aaf5842c46ee4"
